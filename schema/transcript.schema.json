{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Meeting Transcriber transcript, version 1.1",
  "description": "What lmt writes as <stem>.json (design/public-api.md, \"Transcript JSON, version 1.1\"). Readers ignore fields they don't know, so unknown fields are allowed. Segments sorted by start, 0 <= start < end <= source.duration, and speakers that exist are guaranteed by lmt, not stated here.",
  "type": "object",
  "required": ["schema_version", "source", "models", "speakers", "segments"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+(?![\\s\\S])"},
    "lmt_version": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["file", "duration"],
      "properties": {
        "file": {"type": "string"},
        "duration": {"type": "number", "minimum": 0},
        "live": {"const": true},
        "device": {"type": "string"}
      }
    },
    "models": {
      "type": "object",
      "required": ["asr", "diarization"],
      "properties": {
        "asr": {"$ref": "#/$defs/model"},
        "diarization": {"anyOf": [{"$ref": "#/$defs/model"}, {"type": "null"}]}
      }
    },
    "speakers": {"type": "array", "items": {"$ref": "#/$defs/speaker"}},
    "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}}
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": ["name", "repository", "revision"],
      "properties": {
        "name": {"type": "string"},
        "repository": {"type": "string"},
        "revision": {"type": "string"}
      }
    },
    "speaker_id": {"type": "string", "pattern": "^S[1-9][0-9]*(?![\\s\\S])"},
    "speaker": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/speaker_id"},
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[^\\s<>{}=\\x00-\\x1f\\x7f-\\x9f]([^<>{}=\\x00-\\x1f\\x7f-\\x9f]*[^\\s<>{}=\\x00-\\x1f\\x7f-\\x9f])?(?![\\s\\S])"
        }
      }
    },
    "segment": {
      "type": "object",
      "required": ["start", "end", "speaker", "text"],
      "properties": {
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "minimum": 0},
        "speaker": {"$ref": "#/$defs/speaker_id"},
        "text": {"type": "string"},
        "words": {"type": "array", "items": {"$ref": "#/$defs/word"}}
      }
    },
    "word": {
      "type": "object",
      "required": ["start", "end", "text", "probability"],
      "properties": {
        "start": {"type": "number"},
        "end": {"type": "number"},
        "text": {"type": "string"},
        "probability": {"type": "number"}
      }
    }
  }
}
